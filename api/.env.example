PORT=4100

# Explicit opt-in for metered OpenAI, Firecrawl, Tavily, Apollo, and Resend calls.
# This is independent of NODE_ENV, so live execution can be used in development.
ORDIVA_UPSTREAM_MODE=disabled

# Multi-user accounts. Circle email authentication must also be enabled in
# Wallets > User Controlled > Configurator in the Circle Developer Console.
MONGODB_URI=
AUTH_JWT_SECRET=
CIRCLE_API_KEY=
CIRCLE_APP_ID=
CIRCLE_WALLETS_API_URL=https://api.circle.com

# OpenAI generates structured sourcing plans. OPENAI is also accepted as an alias
# for OPENAI_API_KEY so existing local configuration keeps working.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Arc Testnet seller wallet that receives Gateway nanopayments.
# This is the adapter operator's wallet, not a shared buyer wallet.
ARC_ADAPTER_SELLER_ADDRESS=0x0000000000000000000000000000000000000000
# Optional deployed contracts/src/OrdivaRegistry.sol address. When set, the API
# registers each run, anchors its final purchase ledger, and closes it on Arc.
ARC_REGISTRY_ADDRESS=
CIRCLE_GATEWAY_FACILITATOR_URL=https://gateway-api-testnet.circle.com

# Conventional upstreams. Routes with missing credentials return 503 before payment.
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
APOLLO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ordiva Demo <demo@example.com>

# Arc x402 prices. Values must include the leading dollar sign.
PRICE_TAVILY_SEARCH=$0.01
PRICE_FIRECRAWL_SEARCH=$0.01
PRICE_FIRECRAWL_SCRAPE=$0.005
PRICE_FIRECRAWL_CONTACT=$0.01
PRICE_APOLLO_COMPANY=$0.0075
PRICE_RESEND_EMAIL=$0.01
